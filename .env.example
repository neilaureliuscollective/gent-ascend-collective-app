# Local harness is provisioned by npm run dev:setup into .env.development.local.
# Set APP_ENV explicitly to preview or production on Vercel.
APP_ENV=local
AURELIUS_DEV_HARNESS=false
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Aethelios conversations use a server-only OpenAI API key. Never use NEXT_PUBLIC here.
# Keep AI settings in ignored .env.local so dev:setup does not replace them.
# OPENAI_API_KEY=
# AURELIUS_AI_MODEL=gpt-6-astra
# No key is needed to browse the shell/profile/memory; actual replies require one.

# Optional verified Reserve public origin. Leave unset until its hosted experience is approved.
# NEXT_PUBLIC_RESERVE_URL=https://your-reserve-domain.example

# Optional commerce connection. Keep the private Storefront token server-side.
# Products must be published to the Headless channel before they appear.
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# If checkoutUrl uses a custom checkout domain, allow exactly that hostname.
# SHOPIFY_CHECKOUT_HOST=checkout.your-domain.example
