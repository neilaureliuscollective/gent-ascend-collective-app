# Local harness is provisioned by npm run dev:setup into .env.development.local.
# Set APP_ENV explicitly to preview or production on Vercel.
APP_ENV=local
AURELIUS_DEV_HARNESS=false
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Aethelios conversations use a server-only OpenAI API key. Never use NEXT_PUBLIC here.
# Keep AI settings in ignored .env.local so dev:setup does not replace them.
# OPENAI_API_KEY=
# AURELIUS_AI_MODEL=gpt-6-astra
# No key is needed to browse the shell/profile/memory; actual replies require one.

# Optional verified Reserve public origin. Leave unset until its hosted experience is approved.
# NEXT_PUBLIC_RESERVE_URL=https://your-reserve-domain.example

# Optional commerce connection. Keep the private Storefront token server-side.
# Products must be published to the Headless channel before they appear.
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional restriction for the entire Lifestyle assortment. Unset uses Headless-published products.
# SHOPIFY_LIFESTYLE_COLLECTION=your-approved-collection
# Optional Legacy Reserve brand collection; does not restrict general Lifestyle discovery.
# SHOPIFY_LEGACY_RESERVE_COLLECTION=legacy-reserve
# If checkoutUrl uses a custom checkout domain, allow exactly that hostname.
# SHOPIFY_CHECKOUT_HOST=checkout.your-domain.example

# Phase 2 billing: closed by default. Use test Stripe + a separate Supabase project in preview.
# Stripe 23.0.0 / API 2026-09-30.endive. Keys are server-only; never add NEXT_PUBLIC.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# Independent Live cleanup; keep disabled until schema/schedule/provider acceptance.
# AETHELIOS_LIVE_EXPIRY_ENABLED=false
# AETHELIOS_LIVE_CANONICAL_PILOT=false  # explicitly reuse Gent DB for founder-only hosted pilot
# AETHELIOS_LIVE_PREVIEW_PROJECT_REF=  # optional isolated preview target; not needed for canonical pilot
# CRON_SECRET=  # server-only random secret of at least 32 characters
# BILLING_APP_ORIGIN=http://127.0.0.1:3000

# Optional verified public HTTPS origin for product canonical/share metadata and JSON-LD.
# Leave unset until the canonical domain is confirmed. No path, query or credentials.
# NEXT_PUBLIC_APP_URL=https://your-public-domain.example
# Three monthly USD prices on ONE Stripe product: 1999 / 4999 / 7499 cents.
# STRIPE_PRICE_ESSENTIAL=
# STRIPE_PRICE_SIGNATURE=
# STRIPE_PRICE_RESERVE=
# STRIPE_PORTAL_CONFIGURATION=
# STRIPE_PORTAL_RECOVERY_CONFIGURATION=
STRIPE_CHECKOUT_ENABLED=false
FOUNDING_LAUNCH_APPROVED=false
# FOUNDING_TERMS_VERSION=
# FOUNDING_TERMS_TEXT=
# BILLING_TAX_MODE=automatic
# MEMBERSHIP_SUPPORT_EMAIL=

# Public registration remains separate from existing invitations and paid enrollment.
# Enable only after Auth signup, email confirmation, SMTP, redirect URLs and CAPTCHA work.
MEMBERSHIP_SIGNUP_ENABLED=false
MEMBERSHIP_AUTH_READY=false
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Configure the matching secret in Supabase Auth CAPTCHA, not in the public application.

# Customer Account read-only browser connection: disabled until merchant setup and acceptance.
SHOPIFY_CUSTOMER_ACCOUNT_ENABLED=false
# Public Headless Customer Account client, configured for OAuth PKCE. Not a Storefront/Admin token.
# SHOPIFY_CUSTOMER_CLIENT_ID=
# Independent server-only 32-byte AES session key as 64 hex characters. Do not reuse another secret.
# SHOPIFY_CUSTOMER_SESSION_KEY=
# Optional EXACT custom customer-account hostname returned by Shopify discovery.
# SHOPIFY_CUSTOMER_ACCOUNT_HOST=accounts.your-store.example
# Callback to allow in Shopify: <NEXT_PUBLIC_APP_URL>/api/commerce/customer/callback
# Free account claiming is independent of billing. Enable after real Auth validation.
ACCOUNT_SIGNUP_ENABLED=false
ACCOUNT_AUTH_READY=false
ACCOUNT_GOOGLE_READY=false
# ACCOUNT_APP_ORIGIN=http://127.0.0.1:3000
# Use the existing Turnstile key; configure its secret in Supabase Auth.
# Magic link email template must include {{ .Token }} for email-code entry.
# Google provider and /auth/confirm?entry=claim redirect must be allowed in Supabase.

# Verified support inbox. Falls back to MEMBERSHIP_SUPPORT_EMAIL when unset.
# GENT_SUPPORT_EMAIL=
# Anonymous scalar performance reports, disabled until retention/support review.
# Do Not Track and Global Privacy Control suppress client reports. No IDs, URLs or text.
GENT_PERFORMANCE_ENABLED=false

# Verified external Legacy Reserve experience; leave unset until ready. HTTPS only.
LEGACY_RESERVE_PUBLIC_URL=

# AI Footage pilot: OFF until staged migration and real Runway/owner acceptance.
STUDIO_FOOTAGE_ENABLED=false
# RUNWAYML_API_SECRET= server-only Runway developer API key, not an OpenAI token.
# STUDIO_FOOTAGE_SIGNING_KEY= independent random server-only secret, at least 32 characters.
# Preserve the signing key: existing provider receipts depend on it.
# Optional comma-separated EXACT verified HTTPS output hosts; no wildcards.
# STUDIO_FOOTAGE_OUTPUT_HOSTS=

# OpenAI-native Live pilot; local/protected preview only, never enabled in production.
# Uses the existing server-only OPENAI_API_KEY. No ElevenLabs dependency.
# Apply the additive voice migration and verify hosting/sideband/expiry before enabling.
AETHELIOS_LIVE_ENABLED=false
# Hosted preview also requires a documented successful sideband/expiry test.
AETHELIOS_LIVE_CONTROL_READY=false
AETHELIOS_LIVE_MODEL=gpt-realtime
# Cedar or Marin is selected before connection; changing voice requires a new session.

# Enable only after accepted compatible production readers and rollback artifact exist.
# Hosted defaults block expanded company-work writes; this is not founder authority.
FOUNDER_WORK_CONTRACT_READY=0
