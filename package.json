{
  "name": "aurelius-collective-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:setup": "node scripts/dev-setup.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/auth-smoke.mjs",
    "db:reset": "supabase db reset --local && node scripts/dev-setup.mjs --running",
    "db:types": "supabase gen types typescript --local > src/platform/supabase/database.generated.ts",
    "db:ledger": "node scripts/check-migration-ledger.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "test:founder": "playwright test --config playwright.founder.config.ts",
    "test:ai:live": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.development.local node_modules/vitest/vitest.mjs run --config vitest.ai.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.72",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "ai": "7.0.107",
    "gsap": "^3.15.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
